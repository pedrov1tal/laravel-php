APP_ENV=production
APP_DEBUG=false
APP_URL=http://13.140.212.31:8081

# Gere com: php artisan key:generate --show
APP_KEY=
# Gere uma chave aleatoria longa. Se omitido, APP_KEY assina os tokens.
JWT_SECRET=

# URL pooled do projeto Neon. Nunca versione o arquivo .env real.
DB_CONNECTION=pgsql
DB_SSLMODE=require
DB_POOLED=true
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&channel_binding=require"
# Host direto do mesmo projeto Neon, sem o sufixo "-pooler".
DB_DIRECT_HOST=ep-example.us-east-2.aws.neon.tech

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
